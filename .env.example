# Phase 2 — n8n webhook that fronts the Gemini agent.
# Frontend never sees these; only app/api/chat/route.ts (server-side) reads them.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Phase 5 — Supabase (auth + conversation history). Anon key is safe to expose
# to the browser (that's its purpose) — Row Level Security is what actually
# protects data, not keeping this secret. See docs/supabase-schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 4 — text-to-speech provider. Not used yet.
TTS_PROVIDER=
TTS_API_KEY=
